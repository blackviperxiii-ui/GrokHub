{
  "id": "016_replace_twice",
  "prompt": "Change foo to bar in t.txt",
  "mode": "always",
  "files": [{ "path": "t.txt", "content": "foo\n" }],
  "script": [
    {
      "type": "tool",
      "name": "search_replace",
      "arguments": {
        "file_path": "t.txt",
        "old_string": "foo",
        "new_string": "bar"
      },
      "usage": { "input_tokens": 19, "output_tokens": 0 }
    },
    {
      "type": "text",
      "content": "replaced",
      "usage": { "input_tokens": 29, "output_tokens": 3 }
    }
  ],
  "checks": [
    { "type": "file_contains", "path": "t.txt", "value": "bar" }
  ]
}
