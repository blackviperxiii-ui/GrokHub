{
  "id": "007_two_turn",
  "prompt": "Read ping.txt and reply with its contents.",
  "mode": "always",
  "files": [{ "path": "ping.txt", "content": "pong\n" }],
  "script": [
    {
      "type": "tool",
      "name": "read_file",
      "arguments": { "target_file": "ping.txt" },
      "usage": { "input_tokens": 10, "output_tokens": 0 }
    },
    {
      "type": "text",
      "content": "pong",
      "usage": { "input_tokens": 12, "output_tokens": 2 }
    }
  ],
  "checks": [
    { "type": "stop_reason", "value": "end_turn" },
    { "type": "assistant_contains", "value": "pong" }
  ]
}
