{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GrokHub Shell",
  "version": "3.6.0",
  "identifier": "dev.grokhub.shell",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "beforeBundleCommand": "node ../scripts/shell-fps-probe.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Loadout",
        "width": 900,
        "height": 700,
        "minWidth": 420,
        "minHeight": 360,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXkgMzFBQTgzQzNDQjE3MTY3OApSV1I0RmhmTHc0T3FNWHhpWCtsM2svS21BVmZzUnpUcFVEMjh6b3ozSGFjbVdQaXdiVG55WGdlRA==",
      "endpoints": [],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "dmg", "app"],
    "linux": {
      "appimage": {
        "files": {
          "/usr/lib/loadout/fps-probe": "../target/fps-probe/release/loadout-fps-probe",
          "/usr/lib/loadout/grokhub-hub": "../target/hub/release/grokhub-hub"
        }
      },
      "deb": {
        "files": {
          "/usr/lib/loadout/fps-probe": "../target/fps-probe/release/loadout-fps-probe",
          "/usr/lib/loadout/grokhub-hub": "../target/hub/release/grokhub-hub"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
