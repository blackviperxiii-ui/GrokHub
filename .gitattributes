# The agent prompt ships through include_str!, so a CRLF checkout on Windows
# would add a byte per line and push it past the prompt growth budget. Keep
# it LF everywhere so both builds send the same prompt bytes.
crates/grokhub-agent/src/prompt_template.md text eol=lf

# The signed test catalog: its signature covers these exact bytes.
crates/grokhub-core/data/test_catalog/** -text

# The bundled vstack skills ship through include_str! / include_bytes! and are
# hashed byte for byte by .github/scripts/vstack_sync.py check, so keep their
# exact bytes everywhere without Git line-ending conversion.
crates/grokhub-agent/assets/skills/** -text

# Signed release files for the install.sh test: the signature covers
# these exact bytes.
scripts/testdata/** -text
