# Maintainer: GrokHub contributors
pkgname=grokhub
pkgver=0.8.22
pkgrel=1
pkgdesc="Grok-native agent control plane (modes, Imagine, connectors) — Arch desktop"
arch=('x86_64')
url="https://github.com/blackviperxiii-ui/Grok-Hub"
license=('MIT')
depends=('electron' 'nodejs')
makedepends=('npm')
source=()
sha256sums=()

prepare() {
  cd "$startdir/.."
}

build() {
  cd "$startdir/.."
  GROKHUB_DESKTOP=1 npm run build
}

package() {
  cd "$startdir/.."
  install -dm755 "$pkgdir/usr/lib/$pkgname"
  install -dm755 "$pkgdir/usr/bin"
  install -dm755 "$pkgdir/usr/share/applications"

  cp -a desktop .output "$pkgdir/usr/lib/$pkgname/" 2>/dev/null || cp -a desktop "$pkgdir/usr/lib/$pkgname/"
  cp -a package.json "$pkgdir/usr/lib/$pkgname/" 2>/dev/null || true

  install -Dm755 packaging/aur/grokhub.sh "$pkgdir/usr/bin/grokhub"
  install -Dm644 packaging/grokhub.desktop \
    "$pkgdir/usr/share/applications/grokhub.desktop"
  install -Dm644 packaging/grokhub.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/grokhub.svg"
  if [[ -d packaging/icons/hicolor ]]; then
    cp -a packaging/icons/hicolor/. "$pkgdir/usr/share/icons/hicolor/"
  fi
  if [[ -f packaging/icons/grokhub-128.png ]]; then
    install -Dm644 packaging/icons/grokhub-128.png \
      "$pkgdir/usr/share/pixmaps/grokhub.png"
  fi
}
