# Local makepkg from a clone (not the AUR source PKGBUILD).
pkgname=grokhub
pkgver=3.3.0
pkgrel=1
pkgdesc="Grok-native Linux cabin — Rust binary, no Electron"
arch=('x86_64')
url="https://github.com/blackviperxiii-ui/GrokHub"
license=('MIT')
depends=('gtk3' 'libxkbcommon' 'libxkbcommon-x11' 'hicolor-icon-theme')
optdepends=(
  'ffmpeg: Imagine video and local capture leftovers'
  'alsa-utils: Hey Grok mic'
  # CPU llama.cpp in extra; add ggml-vulkan / ggml-cuda / ggml-hip for GPU backends.
  'llama-cpp: local model engine (alternative to in-app download)'
)
makedepends=('cargo' 'rust' 'pkgconf')
options=('!debug')
install=aur/grokhub.install

prepare() { :; }

build() {
  cd "$startdir/.."
  cargo build --release --locked -p grokhub-app -p grokhub-hub
}

package() {
  cd "$startdir/.."
  install -Dm755 target/release/grokhub "$pkgdir/usr/bin/grokhub"
  install -Dm755 target/release/grokhub-hub "$pkgdir/usr/bin/grokhub-hub"
  # KWin matches the .desktop by its Exec path, so ScreenShot2 needs it absolute.
  install -dm755 "$pkgdir/usr/share/applications"
  sed -e 's|^Exec=grokhub$|Exec=/usr/bin/grokhub|' \
      -e 's|^TryExec=grokhub$|TryExec=/usr/bin/grokhub|' \
      packaging/grokhub.desktop >"$pkgdir/usr/share/applications/grokhub.desktop"
  chmod 644 "$pkgdir/usr/share/applications/grokhub.desktop"
  install -Dm644 packaging/grokhub.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/grokhub.svg"
  if [[ -d packaging/icons/hicolor ]]; then
    cp -a packaging/icons/hicolor/. "$pkgdir/usr/share/icons/hicolor/"
  fi
  install -Dm644 packaging/systemd/grokhub-hub.service \
    "$pkgdir/usr/lib/systemd/user/grokhub-hub.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/grokhub/LICENSE"
}
