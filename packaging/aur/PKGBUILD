# Maintainer: GrokHub contributors
# Source package — builds the Arch runtime from the GitHub tree
pkgname=grokhub
pkgver=0.1
pkgrel=1
pkgdesc="Grok-native agent control plane (modes, Imagine, connectors, unsandboxed desktop host)"
arch=('x86_64')
url="https://github.com/blackviperxiii-ui/Grok-Hub"
license=('MIT')
depends=('electron' 'nodejs' 'curl')
makedepends=('npm' 'git')
options=('!strip' '!debug')
install=grokhub.install
source=("${pkgname}::git+https://github.com/blackviperxiii-ui/Grok-Hub.git#branch=main")
sha256sums=('SKIP')

pkgver() {
  cd "${srcdir}/${pkgname}"
  if [[ -f package.json ]]; then
    node -p "require('./package.json').version.replace(/\\.0\$/,'')" 2>/dev/null || echo 0.1
  else
    echo 0.1
  fi
}

build() {
  cd "${srcdir}/${pkgname}"
  if [[ -d node_modules ]]; then
    echo "Using existing node_modules"
  else
    npm ci --ignore-scripts || npm install --ignore-scripts
  fi
  GROKHUB_DESKTOP=1 npm run build
}

package() {
  cd "${srcdir}/${pkgname}"

  install -dm755 "${pkgdir}/usr/lib/grokhub"
  cp -a .output desktop "${pkgdir}/usr/lib/grokhub/"

  install -Dm755 packaging/aur/grokhub.sh "${pkgdir}/usr/bin/grokhub"
  install -Dm644 packaging/grokhub.desktop \
    "${pkgdir}/usr/share/applications/grokhub.desktop"
  install -Dm644 packaging/grokhub.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/grokhub.svg"
  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/grokhub/LICENSE"

  find "${pkgdir}/usr/lib/grokhub" -type f -exec chmod 644 {} +
  find "${pkgdir}/usr/lib/grokhub" -type d -exec chmod 755 {} +
  chmod 755 "${pkgdir}/usr/bin/grokhub"
  chmod 755 "${pkgdir}/usr/lib/grokhub/desktop/main.mjs" || true
}
