# Maintainer: GrokHub contributors
# Prebuilt package — uses committed .output + Electron shell (no npm compile)
pkgname=grokhub-bin
_pkgname=grokhub
pkgver=1.1.10
pkgrel=1
pkgdesc="Grok-native agent control plane (prebuilt) — modes, Imagine, unsandboxed desktop host"
arch=('x86_64')
url="https://github.com/blackviperxiii-ui/Grok-Hub"
license=('MIT')
depends=('electron' 'nodejs' 'curl')
makedepends=('git')
provides=('grokhub')
conflicts=('grokhub')
options=('!strip' '!debug')
install=grokhub.install
source=("${_pkgname}::git+https://github.com/blackviperxiii-ui/Grok-Hub.git#branch=main")
sha256sums=('SKIP')

package() {
  cd "${srcdir}/${_pkgname}"

  if [[ ! -f .output/server/index.mjs ]]; then
    echo "error: .output missing — run GROKHUB_DESKTOP=1 npm run build and push, or use source PKGBUILD" >&2
    return 1
  fi

  install -dm755 "${pkgdir}/usr/lib/${_pkgname}"
  cp -a .output desktop "${pkgdir}/usr/lib/${_pkgname}/"

  install -Dm755 packaging/aur/grokhub.sh "${pkgdir}/usr/bin/grokhub"
  install -Dm644 packaging/grokhub.desktop \
    "${pkgdir}/usr/share/applications/grokhub.desktop"
  install -Dm644 packaging/grokhub.svg \
    "${pkgdir}/usr/share/icons/hicolor/scalable/apps/grokhub.svg"

  if [[ -d packaging/icons/hicolor ]]; then
    cp -a packaging/icons/hicolor/. "${pkgdir}/usr/share/icons/hicolor/"
  fi
  if [[ -f packaging/icons/grokhub-128.png ]]; then
    install -Dm644 packaging/icons/grokhub-128.png \
      "${pkgdir}/usr/share/pixmaps/grokhub.png"
  fi

  install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${_pkgname}/LICENSE"

  find "${pkgdir}/usr/lib/${_pkgname}" -type f -exec chmod 644 {} +
  find "${pkgdir}/usr/lib/${_pkgname}" -type d -exec chmod 755 {} +
  chmod 755 "${pkgdir}/usr/bin/grokhub"
  chmod 755 "${pkgdir}/usr/lib/${_pkgname}/desktop/main.mjs" || true
}
