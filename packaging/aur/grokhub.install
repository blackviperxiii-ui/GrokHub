post_install() {
  gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database /usr/share/applications 2>/dev/null || true

  cat <<'EOF'

  GrokHub 2.6.30 (native Rust — Grok Build GUI)

  Run:    grokhub
  Hub:    grokhub-hub
  Menu:   Applications → GrokHub
  Agent:  install Grok Build from https://x.ai/cli then grok login

  Config: ~/.config/GrokHub
  Computer-use is Grok Build's. Halt cancels the ACP turn.

EOF
}

post_upgrade() {
  post_install
}

post_remove() {
  gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database /usr/share/applications 2>/dev/null || true
}
