post_install() {
  gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database /usr/share/applications 2>/dev/null || true
  GROK_CHANNEL=alpha PREFIX=/usr bash /usr/lib/grokhub/install-grok-cli.sh \
    || echo "grok: install Grok Build CLI alpha with curl -fsSL https://x.ai/cli/install.sh | GROK_CHANNEL=alpha bash"

  cat <<'EOF'

  GrokHub 2.10.12 (native Rust — Grok Build GUI)

  Run:    grokhub
  Hub:    grokhub-hub
  Grok:   grok  (Grok Build CLI alpha from https://x.ai/cli)
  Menu:   Applications → GrokHub
  Sign-in: first launch Get Started (Super Grok OAuth signs in grok too)

  Config: ~/.config/GrokHub
  Computer-use is Grok Build's. Halt cancels the ACP turn.

EOF
}

post_upgrade() {
  post_install
}

post_remove() {
  gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database /usr/share/applications 2>/dev/null || true
}
