post_install() {
  cat <<'EOF'

  GrokHub v0.1 installed.

  Run:    grokhub
  Menu:   Applications → GrokHub

  Depends on system packages: electron, nodejs
  Unsandboxed host agent — commands run as your user.

  Env:
    GROKHUB_PORT=18765
    GROKHUB_WAYLAND=1
    GROKHUB_TRAY=1

EOF
}

post_upgrade() {
  post_install
}
