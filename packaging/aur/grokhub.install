post_install() {
  gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database /usr/share/applications 2>/dev/null || true

  cat <<'EOF'

  Loadout (desktop app)

  Run:    grokhub-shell
  Hub:    grokhub-hub (systemctl --user enable --now grokhub-hub)
  Menu:   Applications → GrokHub Shell
  Sign-in: first launch Get Started (SuperGrok OAuth)

  Config: ~/.config/GrokHub
  Halt on the tray stops the running turn.

EOF
}

post_upgrade() {
  post_install
}

post_remove() {
  gtk-update-icon-cache -f -t /usr/share/icons/hicolor 2>/dev/null || true
  update-desktop-database /usr/share/applications 2>/dev/null || true
}
