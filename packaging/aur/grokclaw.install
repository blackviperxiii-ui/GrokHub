post_install() {
  cat <<'EOF'

  GrokClaw installed.

  Run:    grokclaw
  Menu:   Applications → GrokClaw

  Depends on system packages: electron, nodejs
  Unsandboxed host agent — commands run as your user.

  Env:
    GROKCLAW_PORT=18765
    GROKCLAW_WAYLAND=1
    GROKCLAW_TRAY=1

EOF
}

post_upgrade() {
  post_install
}
