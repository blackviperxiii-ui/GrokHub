[Desktop Entry]
Type=Application
Version=1.5
Name=GrokHub
GenericName=Grok Agent Control Plane
Comment=Grok-native agent desktop — modes, Imagine, Connectors, Skills, Automations
Exec=/usr/bin/grokhub %U
TryExec=/usr/bin/grokhub
Icon=grokhub
Terminal=false
Categories=Utility;Development;Office;Network;AI;
Keywords=grok;ai;agent;xai;hub;electron;automation;chat;
StartupNotify=true
# MUST match Chromium/Electron WM_CLASS / Wayland app_id (see launcher --class=grokhub)
StartupWMClass=grokhub
SingleMainWindow=true
X-GNOME-SingleWindow=true
X-GNOME-UsesNotifications=true
DBusActivatable=false
Actions=NewChat;Settings;Automations;

[Desktop Action NewChat]
Name=New chat
Exec=/usr/bin/grokhub --new-chat

[Desktop Action Settings]
Name=Open settings
Exec=/usr/bin/grokhub --settings

[Desktop Action Automations]
Name=Automations
Exec=/usr/bin/grokhub --automations
